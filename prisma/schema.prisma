datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GuildConfig {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  guildId         String    @unique
  logChannelId    String?
  modLogChannelId String?
  autoRoleId      String?
  antiInvite      Boolean   @default(true)
  antiSpam        Boolean   @default(true)
  maxMentions     Int       @default(5)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  warnings        Warning[]
}

model AutoResponder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId   String
  trigger   String
  response  String
  matchMode String   @default("exact")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, trigger])
  @@index([guildId])
}

model EmbedPreset {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId      String
  name         String
  title        String
  description  String
  color        String   @default("#5865F2")
  thumbnailUrl String?
  imageUrl     String?
  channelId    String?
  messageId    String?
  ownerId      String
  shared       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId, shared])
}

model Warning {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime    @default(now())
  guild       GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId])
}